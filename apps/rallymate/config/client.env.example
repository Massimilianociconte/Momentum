# Copy outside the repository to ~/.config/rallymate/client.env.
# Only client-safe public keys belong here. Never add service_role,
# sb_secret_* or DEEPSEEK_API_KEY.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_OR_PUBLISHABLE_KEY
REVENUECAT_ANDROID_KEY=
REVENUECAT_IOS_KEY=
RALLYMATE_PRIVACY_URL=https://YOUR_PUBLIC_DOMAIN/privacy
RALLYMATE_TERMS_URL=https://YOUR_PUBLIC_DOMAIN/terms
RALLYMATE_LINK_BASE_URL=https://YOUR_PUBLIC_DOMAIN
