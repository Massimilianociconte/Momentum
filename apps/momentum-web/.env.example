# Override del dominio canonico completo, senza slash finale.
# Il default di produzione è già https://playmomentum.it.
PUBLIC_SITE_URL=

# Inserire esclusivamente URL HTTPS reali su apps.apple.com e play.google.com.
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=

# Recapito che riceverà supporto e proposte dal form mailto.
PUBLIC_SUPPORT_EMAIL=
