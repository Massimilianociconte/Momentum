---
import { officialStoreUrl } from '@/lib/store';

const appStoreUrl = officialStoreUrl(import.meta.env.PUBLIC_APP_STORE_URL, 'apple');
const playStoreUrl = officialStoreUrl(import.meta.env.PUBLIC_PLAY_STORE_URL, 'google');

const stores = [
  {
    name: 'App Store',
    overline: 'Scarica su',
    href: appStoreUrl,
    icon: 'apple',
  },
  {
    name: 'Google Play',
    overline: 'Disponibile su',
    href: playStoreUrl,
    icon: 'play',
  },
] as const;
---

<div class="store-buttons" aria-label="Disponibilità negli store">
  {
    stores.map((store) =>
      store.href ? (
        <a
          class="store-button"
          href={store.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${store.name}, apre una nuova scheda`}
        >
          {store.icon === 'apple' ? (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.29-.07 2.19.71 2.95.77 1.13-.23 2.21-.89 3.42-.8 1.46.12 2.56.69 3.29 1.73-3.01 1.8-2.3 5.77.46 6.88-.55 1.45-1.27 2.89-2.12 4.39ZM12.03 7.25C11.88 5.1 13.63 3.33 15.64 3.16c.28 2.49-2.26 4.35-3.61 4.09Z"
              />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m3.6 2.4 10.77 9.6L3.6 21.6c-.38-.42-.6-1-.6-1.65V4.05c0-.65.22-1.23.6-1.65Z" />
              <path d="m15.72 13.2 2.55 2.28-11.83 6.68 9.28-8.96Z" />
              <path d="M18.27 8.52 15.72 10.8 6.44 1.84l11.83 6.68Z" />
              <path d="M20.31 9.67c.9.5.9 1.83 0 2.33l-1.38.78L16.8 12l2.13-.78 1.38-1.55Z" />
            </svg>
          )}
          <span>
            <small>{store.overline}</small>
            <strong>{store.name}</strong>
          </span>
        </a>
      ) : (
        <span class="store-button store-button--disabled" aria-label={`${store.name}: in arrivo`}>
          {store.icon === 'apple' ? (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.29-.07 2.19.71 2.95.77 1.13-.23 2.21-.89 3.42-.8 1.46.12 2.56.69 3.29 1.73-3.01 1.8-2.3 5.77.46 6.88-.55 1.45-1.27 2.89-2.12 4.39ZM12.03 7.25C11.88 5.1 13.63 3.33 15.64 3.16c.28 2.49-2.26 4.35-3.61 4.09Z"
              />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m3.6 2.4 10.77 9.6L3.6 21.6c-.38-.42-.6-1-.6-1.65V4.05c0-.65.22-1.23.6-1.65Z" />
              <path d="m15.72 13.2 2.55 2.28-11.83 6.68 9.28-8.96Z" />
              <path d="M18.27 8.52 15.72 10.8 6.44 1.84l11.83 6.68Z" />
            </svg>
          )}
          <span>
            <small>Presto su</small>
            <strong>{store.name}</strong>
          </span>
        </span>
      ),
    )
  }
</div>
