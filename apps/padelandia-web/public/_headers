# Header applicati da Cloudflare Workers static assets (parsato dal deploy,
# non servito come asset). Rif: developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'

# llms.txt / llms-full.txt: Google dichiara di ignorarli (Search Central,
# guida "Optimizing your website for generative AI features") e sconsiglia di
# lasciarli indicizzare come pagine autonome. Restano serviti per gli altri
# assistenti, fuori dall'indice di ricerca.
/llms.txt
  X-Robots-Tag: noindex

/llms-full.txt
  X-Robots-Tag: noindex

# Asset fingerprinted da Astro: cache aggressiva lato browser.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
