---
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pagina non trovata"
  description="La pagina che cercavi non è disponibile."
  robots="noindex, follow"
>
  <SiteHeader />
  <main id="contenuto" class="not-found">
    <div class="container">
      <p class="not-found__score" aria-hidden="true">40 · 404</p>
      <h1>Palla fuori.</h1>
      <p>La pagina che cercavi non è più in questo campo.</p>
      <a class="button button--primary" href="/">Torna alla home</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
