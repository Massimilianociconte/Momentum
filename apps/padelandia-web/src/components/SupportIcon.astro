---
export type IconName =
  | 'book'
  | 'headset'
  | 'users'
  | 'arrow'
  | 'bug'
  | 'spark'
  | 'watch'
  | 'undo'
  | 'offline'
  | 'chart'
  | 'check'
  | 'cloud';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 28 } = Astro.props;
---

<svg
  class="support-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'book' && (
      <>
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" />
      </>
    )
  }
  {
    name === 'headset' && (
      <>
        <path d="M4 14a8 8 0 0 1 16 0" />
        <path d="M18 19c0 1.1-.9 2-2 2h-3" />
        <path d="M4 14v3a2 2 0 0 0 2 2h1v-7H6a2 2 0 0 0-2 2Z" />
        <path d="M20 14v3a2 2 0 0 1-2 2h-1v-7h1a2 2 0 0 1 2 2Z" />
      </>
    )
  }
  {
    name === 'users' && (
      <>
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
      </>
    )
  }
  {
    name === 'arrow' && (
      <>
        <path d="M5 12h14" />
        <path d="m13 6 6 6-6 6" />
      </>
    )
  }
  {
    name === 'bug' && (
      <>
        <path d="m8 2 1.88 1.88" />
        <path d="M14.12 3.88 16 2" />
        <path d="M9 7.13V6a3 3 0 0 1 6 0v1.13" />
        <path d="M12 20c-3.31 0-6-2.69-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.31-2.69 6-6 6Z" />
        <path d="M12 20v-9" />
        <path d="M6 13H2" />
        <path d="M22 13h-4" />
      </>
    )
  }
  {
    name === 'spark' && (
      <>
        <path d="m12 3-1.8 4.2L6 9l4.2 1.8L12 15l1.8-4.2L18 9l-4.2-1.8L12 3Z" />
        <path d="m19 15-.9 2.1L16 18l2.1.9L19 21l.9-2.1L22 18l-2.1-.9L19 15Z" />
      </>
    )
  }
  {
    name === 'watch' && (
      <>
        <rect x="6" y="6" width="12" height="12" rx="3" />
        <path d="M9 6V3h6v3" />
        <path d="M9 18v3h6v-3" />
        <path d="M12 10v2.5l1.6 1" />
      </>
    )
  }
  {
    name === 'undo' && (
      <>
        <path d="M3 8h11a5 5 0 0 1 0 10H9" />
        <path d="m7 4-4 4 4 4" />
      </>
    )
  }
  {
    name === 'offline' && (
      <>
        <path d="M5 18a4 4 0 0 1 .6-7.96 6 6 0 0 1 10.6-2.6" />
        <path d="M19 12.2A4 4 0 0 1 18 20H9" />
        <path d="m3 3 18 18" />
      </>
    )
  }
  {
    name === 'chart' && (
      <>
        <path d="M3 3v16.5A1.5 1.5 0 0 0 4.5 21H21" />
        <path d="m7 15 3.5-4 3 2.6L20 7" />
      </>
    )
  }
  {
    name === 'check' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="m8.5 12.3 2.4 2.4 4.6-5" />
      </>
    )
  }
  {
    name === 'cloud' && (
      <>
        <path d="M6.5 19a4.5 4.5 0 0 1-.4-8.98 6 6 0 0 1 11.63 1.06A3.75 3.75 0 0 1 17.5 19Z" />
      </>
    )
  }
</svg>
